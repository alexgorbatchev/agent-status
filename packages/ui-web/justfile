# Justfile for ui-web

# Default recipe
default:
    @just --list

# Run dev server
run:
    bun run src/server.ts

# Run dev server in AI mode
run-ai:
    AGENT=1 bun run src/server.ts

# Build frontend bundle
build:
    bun run build

# Run policy checks and TypeScript compiler check
lint:
    bun run check
    bun x tsc --noEmit

# Run policy checks followed by unit test suite
test:
    bun run check
    NODE_ENV=test bun test src

# Run Playwright E2E test suite
test-e2e:
    bun run test:e2e

# Clean artifacts
clean:
    rm -rf dist/
