{
  "name": "@agent-status/ui-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "build": "bun run src/build.ts",
    "check": "bun run typescript-ai-policy -- check",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typescript-ai-policy -- check && bun x tsc --noEmit",
    "test": "bun run check && NODE_ENV=test bun test src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@xstate/react": "^6.1.0",
    "bun-plugin-tailwind": "^0.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@alexgorbatchev/typescript-ai-policy": "^13.0.0",
    "@playwright/test": "^1.63.0",
    "@storybook/react": "^10.6.0",
    "@storybook/test": "^8.6.15",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
