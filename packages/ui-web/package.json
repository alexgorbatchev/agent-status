{
  "name": "@agent-status/ui-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "build": "bun run src/build.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typescript-ai-policy -- check",
    "lint": "bun run typescript-ai-policy -- check && bun x tsc --noEmit",
    "test": "bun run check && bun test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@alexgorbatchev/typescript-ai-policy": "^13.0.0",
    "@storybook/react": "^10.6.0",
    "@storybook/test": "^8.6.15",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^5.7.0"
  }
}
