# Default recipe: list available tasks
default:
    @just --justfile "{{ module_directory() }}/justfile" --list

# Build agent-observer binary strictly into bin/
build:
    @mkdir -p bin
    go build -o bin/agent-observer ./cmd/agent-observer

# Run all unit tests with race detector and verify >= 90% coverage
test *args:
    ../../scripts/check-coverage.sh -race {{ if args == "" { "./..." } else { args } }}

# Check module hygiene and run vet + linter
lint:
    @out="$(gofmt -l .)"; if [ -n "$out" ]; then echo "Unformatted Go files:"; echo "$out"; exit 1; fi
    go mod tidy -diff
    go vet ./...
    golangci-lint run

# Clean build artifacts
clean:
    rm -rf bin/

# Download module dependencies
setup:
    go mod download

# Run the devhost service with repository-local application state
dev: build
    #!/usr/bin/env sh
    set -eu
    cd "{{ module_directory() }}/../.."
    mkdir -p .tmp/dev-stack/data .tmp/dev-stack/cache .tmp/dev-stack/logs .tmp/dev-stack/run
    unset AGENT_STATUS_LOG_FILE AGENT_STATUS_SESSION_STATE_PATH
    exec packages/agent-observer/bin/agent-observer --ingester-url "$AGENT_STATUS_INGESTER_WS_URL" --token dev-secret-token --cursor-path .tmp/dev-stack/cache/observer-cursors.json --session-state-path .tmp/dev-stack/cache/session-state.json --log-dir .tmp/dev-stack/logs
