default:
    @just --list

run *args:
    cargo run --package agent-observer --locked -- {{ args }}

run-ai *args:
    AGENT=1 cargo run --package agent-observer --locked -- {{ args }}

test:
    mkdir -p .tmp
    cargo test --package agent-observer --locked --all-targets

lint:
    cargo fmt --package agent-observer -- --check
    cargo clippy --package agent-observer --locked --all-targets -- -D warnings

coverage:
    mkdir -p .tmp
    cargo llvm-cov --package agent-observer --locked --all-targets --fail-under-lines 90

check: lint test coverage

build:
    cargo build --package agent-observer --locked --release
    mkdir -p bin
    cp "$(cargo metadata --locked --offline --format-version 1 --no-deps | jq -r .target_directory)/release/agent-observer" bin/agent-observer
# Run the devhost service with repository-local application state
dev: build
    #!/usr/bin/env sh
    set -eu
    cd "{{ module_directory() }}/../.."
    mkdir -p .tmp/dev-stack/data .tmp/dev-stack/cache .tmp/dev-stack/logs .tmp/dev-stack/run
    unset AGENT_STATUS_LOG_FILE AGENT_STATUS_SESSION_STATE_PATH
    exec packages/agent-observer/bin/agent-observer --ingester-url "$AGENT_STATUS_INGESTER_WS_URL" --token dev-secret-token --cursor-path .tmp/dev-stack/cache/observer-cursors.json --session-state-path .tmp/dev-stack/cache/session-state.json --log-dir .tmp/dev-stack/logs
