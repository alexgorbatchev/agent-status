# Justfile for agent-ingester

# Default recipe: list available tasks
default:
    @just --justfile "{{ module_directory() }}/justfile" --list

# Run in human-facing interactive mode
run *args:
    @mkdir -p bin
    go run ./cmd/air-ingester {{ args }}

# Run in agent-facing token-conservative mode
run-ai *args:
    AGENT=1 just run {{ args }}

# Build compiled binary into bin/
build:
    @mkdir -p bin
    go build -o bin/air-ingester ./cmd/air-ingester

# Run all unit and integration tests with race detector and verify >= 90% coverage
test *args:
    ../../scripts/check-coverage.sh -race {{ if args == "" { "./..." } else { args } }}

# Lint and check module hygiene
lint:
    @out="$(gofmt -l .)"; if [ -n "$out" ]; then echo "Unformatted Go files:"; echo "$out"; exit 1; fi
    go mod tidy -diff
    go vet ./...
    golangci-lint run

# Clean build artifacts
clean:
    rm -rf bin/

# Download module dependencies
setup:
    go mod download

# Run the devhost service with repository-local application state
dev: build
    #!/usr/bin/env sh
    set -eu
    cd "{{ module_directory() }}/../.."
    mkdir -p .tmp/dev-stack/data/agent-status .tmp/dev-stack/cache .tmp/dev-stack/logs .tmp/dev-stack/run
    unset AIR_LOG_FILE AIR_SESSION_STATE_PATH
    exec packages/agent-ingester/bin/air-ingester --addr "$DEVHOST_BIND_HOST:$PORT" --token dev-secret-token --db .tmp/dev-stack/data/agent-status/agent-status.db --notify-sock .tmp/dev-stack/run/notify.sock --log-dir .tmp/dev-stack/logs
