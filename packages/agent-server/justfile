# Justfile for agent-server

# Default recipe: list available tasks
default:
    @just --justfile "{{ module_directory() }}/justfile" --list

# Run in human-facing interactive mode
run:
    go run ./cmd/air-server

# Run in agent-facing token-conservative mode
run-ai:
    @AGENT=1 go run ./cmd/air-server

# Build compiled binary strictly into bin/
build:
    @mkdir -p bin
    go build -o bin/air-server ./cmd/air-server

# Run all unit tests with race detector and verify >= 90% coverage
test *args:
    ../../scripts/check-coverage.sh -race {{ if args == "" { "./..." } else { args } }}

# Check module hygiene and run vet + linter
lint:
    @out="$(gofmt -l .)"; if [ -n "$out" ]; then echo "Unformatted Go files:"; echo "$out"; exit 1; fi
    go mod tidy -diff
    go vet ./...
    golangci-lint run

# Clean build artifacts
clean:
    rm -rf bin/

# Download module dependencies
setup:
    go mod download

# Run the devhost service with repository-local application state
dev: build
    #!/usr/bin/env sh
    set -eu
    cd "{{ module_directory() }}/../.."
    mkdir -p .tmp/dev-stack/data .tmp/dev-stack/cache .tmp/dev-stack/logs .tmp/dev-stack/run
    unset AIR_LOG_FILE AIR_SESSION_STATE_PATH
    exec packages/agent-server/bin/air-server --addr "$DEVHOST_BIND_HOST:$PORT" --token dev-secret-token --db .tmp/dev-stack/data/agent-status.db --socket .tmp/dev-stack/run/notify.sock --ingester-url "$AGENT_INGESTER_URL" --log-dir .tmp/dev-stack/logs
